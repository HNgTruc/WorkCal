# Biến môi trường cho docker-compose.yml.
# Tạo file .env:  Copy-Item .env.example .env  rồi đổi cả 3 mật khẩu bên dưới.
# .env nằm trong .gitignore, không commit. Không dùng ký tự $ trong mật khẩu.

# Mật khẩu tài khoản sa của SQL Server.
# Bắt buộc: ít nhất 8 ký tự, có chữ hoa, chữ thường, số và ký tự đặc biệt.
MSSQL_SA_PASSWORD=Ntruc1405@

# Mật khẩu Redis
REDIS_PASSWORD=Ntruc1405@

# Mật khẩu admin ban đầu của Seq (http://localhost:5341); Seq bắt đổi ở lần đăng nhập đầu
SEQ_ADMIN_PASSWORD=Ntruc1405@
