# Git tự chuẩn hóa xuống dòng cho file văn bản; khớp với .editorconfig.
* text=auto

# Code .NET và file Windows: CRLF
*.cs        text eol=crlf diff=csharp
*.csproj    text eol=crlf
*.props     text eol=crlf
*.targets   text eol=crlf
*.sln       text eol=crlf
*.slnx      text eol=crlf
*.xaml      text eol=crlf
*.razor     text eol=crlf
*.resx      text eol=crlf
*.ps1       text eol=crlf
*.cmd       text eol=crlf
*.bat       text eol=crlf

# Chạy trên Linux (CI, Docker): LF
*.sh        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
Dockerfile  text eol=lf

# File nhị phân
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.xlsx      binary
*.ttf       binary
*.woff      binary
*.woff2     binary
*.pfx       binary
*.snk       binary
*.db        binary
